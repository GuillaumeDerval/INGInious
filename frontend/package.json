{
	"name": "inginious-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"inginious-autotest": "build-cli/inginious-autotest.js",
		"inginious-test-task": "build-cli/inginious-test-task.js",
		"inginious-setup": "build-cli/inginious-setup.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cli": "vite build -c cli/vite.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --coverage",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "rm -rf coverage/e2e && COVERAGE=1 vite build && sh -c 'playwright test; status=$?; node e2e/coverage-report.mjs && exit $status'",
		"test:perf": "sh -c 'ID=${PERF_ID:-main}; rm -f perf/results/$ID.jsonl && KIT_OUT_DIR=.svelte-kit-perf-$ID BUILD_OUT=build-perf-$ID vite build && jiti perf/seed.ts && BUILD_OUT=build-perf-$ID playwright test -c playwright.perf.config.ts \"$@\"' --",
		"test:e2e:run": "sh -c 'ID=${E2E_ID:?set E2E_ID}; rm -rf coverage/e2e-$ID && KIT_OUT_DIR=.svelte-kit-$ID BUILD_OUT=build-$ID COVERAGE=1 vite build && BUILD_OUT=build-$ID playwright test \"$@\"; COVERAGE_STRICT=0 node e2e/coverage-report.mjs' --"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"@types/tar-stream": "^3.1.5",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"gettext-parser": "^9.1.1",
		"globals": "^17.6.0",
		"monocart-coverage-reports": "^2.13.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.14",
		"@lucide/svelte": "^1.56.0",
		"@msgpack/msgpack": "^3.1.3",
		"@node-rs/argon2": "^2.2.2",
		"@node-saml/node-saml": "^5.1.0",
		"@sentry/browser": "^11.7.0",
		"arctic": "^3.7.0",
		"chart.js": "^4.5.1",
		"codemirror": "^6.0.2",
		"cookie": "^2.0.1",
		"fflate": "^0.8.3",
		"highlight.js": "^11.12.0",
		"jose": "^6.2.12",
		"katex": "^0.19.0",
		"ldapts": "^9.2.0",
		"markdown-it": "^15.0.2",
		"mongodb": "^7.7.0",
		"nodemailer": "^10.1.0",
		"rst-compiler": "^0.5.9",
		"sanitize-html": "^2.18.0",
		"tar-stream": "^3.2.2",
		"yaml": "^2.9.1",
		"zeromq": "^6.8.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"rst-compiler": {
			"katex": "$katex"
		}
	}
}
