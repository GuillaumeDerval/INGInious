# Base core container. This is not a service per-se but is used as a common layer for the core services.
FROM rockylinux/rockylinux:10 AS core

ARG PYTHON_VERSION=3.14

RUN dnf update -y && dnf install -y python"${PYTHON_VERSION}" python"${PYTHON_VERSION}"-pip git

WORKDIR /inginious
COPY pyproject.toml README.rst ./
COPY inginious/common/ inginious/common/
COPY inginious/__init__.py inginious/

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

##########
# BACKEND
##########
FROM core AS backend 

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/backend/ inginious/backend/
COPY inginious/scripts/ inginious/scripts/

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN  --mount=source=.git,target=.git,type=bind \
     pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD  ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.backend ${AGENT} ${CLIENT}"]


###########
# FRONTEND
###########
# The web frontend (SvelteKit, frontend/) is a Node.js application: it is built in a
# separate stage and served by adapter-node on port 8000. It also serves WebDAV under /dav.
FROM docker.io/library/node:24-bookworm-slim AS frontend_build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN  npm ci
COPY frontend/ ./
# Optional fixed public URL (https://your.host); by default it comes from the proxy's X-Forwarded-* headers.
ARG  APP_ORIGIN=
RUN  APP_ORIGIN="$APP_ORIGIN" npx vite build && npm prune --omit=dev

FROM docker.io/library/node:24-bookworm-slim AS frontend

# git: marketplace course import and the git_repo plugin.
RUN  apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /frontend
ARG  APP_ORIGIN=
ENV  NODE_ENV=production PORT=8000 INGINIOUS_CONFIG=/inginious/configuration.yaml APP_ORIGIN=$APP_ORIGIN
COPY --from=frontend_build /frontend/build ./build
COPY --from=frontend_build /frontend/node_modules ./node_modules
COPY --from=frontend_build /frontend/package.json ./

# Runs as root like the other INGInious services, so that it can manage the course
# files of existing deployments (tasks directory written by the previous frontend).
EXPOSE 8000
CMD ["node", "build"]


###########
# AGENT MCQ 
###########

FROM core AS agent_mcq

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/agent/__init__.py inginious/agent/
COPY inginious/agent/mcq_agent/ inginious/agent/mcq_agent/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.agent_mcq ${BACKEND}"]

##############
# AGENT DOCKER
##############

FROM core AS agent_docker

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/agent/__init__.py inginious/agent/
COPY inginious/agent/docker_agent/ inginious/agent/docker_agent/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.agent_docker ${BACKEND} --tmpdir=/tmp/agent_data/"]
